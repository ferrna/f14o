---
/**
 * Cartas 16:9 para el case: mismo data-deck que /lab, fotos reales
 * con blur de fondo + contain. El JS no cambia.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface DeckFrame {
  src: ImageMetadata;
  caption: string;
}

interface Props {
  frames: DeckFrame[];
  /** View transition del cover, sólo en la primera carta. */
  transitionName?: string;
}

const { frames, transitionName } = Astro.props;
const figures = frames.map((frame) => frame.caption).join('|');
---

{
  frames.length > 0 && (
    <div class="case-deck" data-deck data-cursor-drag aria-roledescription="carousel">
      <div class="case-deck__stage" data-deck-stage>
        {frames.map((frame, i) => (
          <figure class="case-deck__card" data-deck-card data-index={i}>
            <Image
              src={frame.src}
              alt=""
              widths={[720, 960]}
              sizes="(max-width: 760px) 88vw, min(76vw, 640px)"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class="case-deck__bg"
              aria-hidden="true"
            />
            <Image
              src={frame.src}
              alt={frame.caption}
              widths={[720, 960]}
              sizes="(max-width: 760px) 88vw, min(76vw, 640px)"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="case-deck__img"
              style={i === 0 && transitionName ? `view-transition-name: ${transitionName}` : undefined}
            />
          </figure>
        ))}
      </div>

      <div class="case-deck__bar">
        <p data-deck-caption data-figures={figures}>
          Fig. 01 — {frames[0]?.caption}
        </p>
        <p data-deck-counter>01 / {String(frames.length).padStart(2, '0')}</p>
      </div>
      <div class="case-deck__progress" aria-hidden="true">
        <span data-deck-progress></span>
      </div>
    </div>
  )
}

<style lang="scss">
  @use 'tokens' as *;

  .case-deck {
    position: relative;
    margin-top: clamp(1.75rem, 4vh, 2.75rem);
  }

  .case-deck__stage {
    position: relative;
    height: min(48vh, 420px);
    perspective: 1400px;
    transform-style: preserve-3d;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .case-deck__stage[data-dragging='true'] {
    cursor: grabbing;
  }

  @media (hover: hover) and (pointer: fine) {
    @media (prefers-reduced-motion: no-preference) {
      .case-deck,
      .case-deck * {
        cursor: none;
      }
    }
  }

  /* left/width, no translate: GSAP escribe transform en la carta. */
  .case-deck__card {
    position: absolute;
    top: 50%;
    left: calc(50% - min(38%, 320px));
    width: min(76%, 640px);
    aspect-ratio: 16 / 9;
    margin-top: calc(min(76%, 640px) * -9 / 32);
    overflow: hidden;
    border: 1px solid $c-hairline-strong;
    border-radius: 4px;
    background-color: $c-obsidian;
    box-shadow: 0 24px 60px rgba(13, 11, 10, 0.5);
    transform-style: preserve-3d;
  }

  .case-deck__bg,
  .case-deck__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .case-deck__bg {
    object-fit: cover;
    filter: blur(26px) saturate(1.35) brightness(0.85);
    transform: scale(1.35);
  }

  .case-deck__img {
    top: 50%;
    left: 50%;
    z-index: 1;
    width: auto;
    max-width: calc(100% - 24px);
    height: calc(100% - 40px);
    object-fit: contain;
    transform: translate(-50%, -50%);
  }

  .case-deck__bar {
    @include mono(0.62rem);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.1rem;
    color: $c-subtle;
  }

  .case-deck__progress {
    height: 2px;
    margin-top: 0.75rem;
    background-color: $c-hairline;

    span {
      display: block;
      height: 100%;
      background-color: $c-violet;
      transform: scaleX(0.33);
      transform-origin: left center;
    }
  }

  @media (max-width: 760px) {
    .case-deck__card {
      left: 6%;
      width: 88%;
      margin-top: calc(88% * -9 / 32);
    }
  }
</style>
