---
import Sculpture from './Sculpture.astro';
import AboutPlate from './AboutPlate.astro';
import { path, type Lang } from '../i18n/config';
import { useCopy } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useCopy(lang);

const facts = [
  { label: c.about.facts.based, value: c.about.location },
  { label: c.about.facts.experience, count: 3, suffix: c.about.years },
  { label: c.about.facts.focus, value: c.about.focus },
];
---

<section class="about" data-about data-sculpture-stage>
  <div class="about__wipe" data-about-wipe hidden>
    <p class="about__wipe-label">{c.about.kicker}</p>
    <span class="about__wipe-line" aria-hidden="true"></span>
  </div>

  <p class="about__kicker"><span class="about__dot" aria-hidden="true"></span>01 / {c.about.kicker}</p>

  <div class="about__layout">
    <figure class="about__visual" data-about-visual>
      <!-- Único lugar del sitio donde la escultura puede ser grande: en
           una página que habla de mí, el objeto es el sujeto y no un logo. -->
      <Sculpture variant="about" />
      <figcaption>{c.about.caption}</figcaption>
    </figure>

    <h1 class="about__headline" data-about-headline data-reveal-group="blocks">
      {
        c.about.headline.map((line, i) => (
          <span data-reveal-item>
            {i === 1 && <i class="about__dash" aria-hidden="true" />}
            {line}
          </span>
        ))
      }
    </h1>

    <div class="about__rest" data-reveal-group="blocks">
      <div class="about__prose" data-reveal-item>
        {c.about.prose.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <span class="about__rule" data-rule aria-hidden="true"></span>

      <dl class="about__facts" data-reveal-item>
        {
          facts.map((fact) => (
            <div class="about__fact">
              <dt>{fact.label}</dt>
              <dd>
                {fact.count ? (
                  <>
                    <span data-count-to={fact.count}>0</span>
                    {fact.suffix}
                  </>
                ) : (
                  fact.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <a class="about__cv" href={path(lang, '/#contact')} data-reveal-item data-cursor-hover>
        <span class="about__dot" aria-hidden="true"></span>
        {c.about.cta}
      </a>
    </div>
  </div>

  <p class="about__foot">{c.about.foot}</p>
</section>

<AboutPlate lang={lang} />

<style lang="scss">
  @use 'tokens' as *;

  .about {
    position: relative;
    z-index: $z-content;
    padding: clamp(7.5rem, 16vh, 10rem) $space-page clamp(4rem, 10vh, 6rem);
  }

  .about__wipe {
    position: fixed;
    inset: 0;
    z-index: $z-curtain;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    background-color: $c-obsidian;
  }

  .about__wipe[hidden] {
    display: none;
  }

  .about__wipe-label {
    @include mono(0.72rem);
    color: $c-cream;
  }

  .about__wipe-line {
    display: block;
    width: min(42vw, 220px);
    height: 1px;
    background: linear-gradient(90deg, $c-violet, $c-cream 45%, $c-cream 55%, $c-violet);
  }

  .about__kicker {
    @include mono(0.68rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: $c-muted;
  }

  .about__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: $c-violet;
  }

  .about__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    column-gap: clamp(3rem, 8vw, 6.5rem);
    row-gap: clamp(2.5rem, 6vh, 4rem);
    margin-top: clamp(3rem, 8vh, 5.5rem);
  }

  .about__visual {
    position: relative;
    max-width: 420px;
    margin: 0 auto;
    padding-bottom: 2.5rem;

    figcaption {
      @include mono(0.6rem);
      margin-top: 2rem;
      color: $c-subtle;
      opacity: 0.72;
    }
  }

  .about__headline {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;

    span {
      @include display(clamp(2.2rem, 5vw, 4rem));
      color: $c-cream;
    }
  }

  .about__dash {
    display: inline-block;
    width: 1.4rem;
    height: 2px;
    margin-right: 0.7rem;
    margin-bottom: 0.28em;
    vertical-align: middle;
    background-color: $c-violet;
  }

  .about__rest {
    grid-column: 2;
  }

  .about__prose {
    max-width: 46ch;
    color: $c-muted;
    font-size: 0.95rem;
    line-height: 1.75;

    p + p {
      margin-top: 1rem;
    }
  }

  .about__rule {
    display: block;
    height: 1px;
    margin: clamp(2.4rem, 5vh, 3.5rem) 0;
    background-color: $c-hairline;
    transform-origin: left center;
  }

  .about__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin: 0;
  }

  .about__fact {
    dt {
      @include mono(0.6rem);
      color: $c-subtle;
    }

    dd {
      @include mono(0.76rem);
      margin: 0.45rem 0 0;
      color: $c-cream;
      text-transform: none;
    }
  }

  .about__cv {
    @include mono(0.66rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(2.4rem, 5vh, 3.5rem);
    padding: 0.7rem 1.3rem;
    border: 1px solid $c-violet;
    border-radius: 999px;
    color: $c-cream;
    transition: background-color $dur-micro $ease-micro;

    &:hover {
      background-color: $c-violet-dim;
    }
  }

  .about__foot {
    @include mono(0.62rem);
    margin-top: clamp(4rem, 10vh, 6rem);
    color: $c-subtle;
    opacity: 0.72;
  }

  @media (max-width: 760px) {
    .about__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: end;
      column-gap: 1.25rem;
    }

    .about__visual {
      max-width: none;
      padding-bottom: 1.25rem;

      figcaption {
        margin-top: 1rem;
      }
    }

    .about__headline span {
      @include display(clamp(1.55rem, 7vw, 2.2rem));
    }

    .about__rest,
    .about__foot {
      grid-column: 1 / -1;
    }

    .about__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
