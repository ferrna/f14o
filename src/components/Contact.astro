---
import { email, links, useSite } from '../data/site';
import type { Lang } from '../i18n/config';
import { useCopy } from '../i18n/ui';
import Swap from './Swap.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useCopy(lang);
const site = useSite(lang);
---

<section class="contact" id="contact">
  <p class="contact__kicker">
    <span class="contact__dot" aria-hidden="true"></span>05 / {c.contact.kicker}
  </p>

  <h2 class="contact__headline" data-reveal-group="blocks">
    {site.contactHeadline.map((line) => <span class="contact__line" data-reveal-item>{line}</span>)}
  </h2>

  <div class="contact__row" data-reveal>
    <a class="contact__email" href={`mailto:${email}`} data-cursor-hover>
      {email}
      <span class="contact__underline" aria-hidden="true"></span>
    </a>

    <button
      class="contact__copy"
      type="button"
      data-copy={email}
      data-copied-label={c.contact.copied}
      data-cursor-hover
    >
      <span data-copy-label>{c.contact.copy}</span>
    </button>
  </div>

  <ul class="contact__links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} rel="noopener noreferrer" data-cursor-hover>
            <Swap text={link.label} />
            <span class="sr-only">{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style lang="scss">
  @use 'tokens' as *;

  .contact {
    position: relative;
    z-index: $z-content;
    padding: $space-section $space-page clamp(3rem, 7vh, 5rem);
    text-align: center;
  }

  .contact__kicker {
    @include mono(0.68rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: $c-muted;
  }

  .contact__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: $c-violet;
  }

  .contact__headline {
    display: flex;
    flex-direction: column;
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }

  .contact__line {
    @include display(clamp(2rem, 5.5vw, 4.2rem));
    color: $c-cream;
  }

  .contact__row {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }

  .contact__email {
    @include mono(clamp(0.85rem, 1.6vw, 1.15rem));
    position: relative;
    color: $c-cream;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  // El email es el único elemento con subrayado animado del sitio.
  .contact__underline {
    position: absolute;
    left: 0;
    bottom: -0.4rem;
    width: 100%;
    height: 1px;
    background-color: $c-hairline-strong;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform $dur-short $ease-out-soft;
  }

  .contact__email:hover .contact__underline {
    transform: scaleX(1);
  }

  .contact__copy {
    @include mono(0.64rem);
    padding: 0.5rem 1rem;
    border: 1px solid $c-hairline-strong;
    border-radius: 999px;
    color: $c-muted;
    transition:
      border-color $dur-micro $ease-micro,
      color $dur-micro $ease-micro,
      background-color $dur-micro $ease-micro;

    &:hover {
      border-color: $c-violet;
      color: $c-cream;
    }
  }

  // Confirmación deliberadamente silenciosa: la misma píldora cambia de
  // estado. Un toast acá rompería el tono sobrio del resto.
  .contact__copy[data-copied='true'] {
    border-color: $c-violet;
    background-color: $c-violet-dim;
    color: $c-cream;
  }

  .contact__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    margin-top: clamp(2.5rem, 6vh, 4rem);

    a {
      @include mono(0.68rem);
      display: inline-flex;
      color: $c-subtle;
      transition: color $dur-micro $ease-micro;

      &:hover {
        color: $c-cream;
      }
    }
  }

  @media (max-width: 760px) {
    .contact__row {
      flex-direction: column;
      gap: 1.25rem;
    }
  }
</style>
