---
import { Image } from 'astro:assets';
import sculpture from '../assets/worm/worm-legacy.png';

interface Props {
  /** hero: contenida detrás del título. about: protagonista. lost: desarmada. */
  variant: 'hero' | 'about' | 'lost';
  class?: string;
}

const { variant, class: className } = Astro.props;

const widths: Record<Props['variant'], number[]> = {
  hero: [240, 400],
  about: [520, 900],
  lost: [320, 560],
};
---

<div class:list={['sculpture', `sculpture--${variant}`, className]} data-sculpture={variant} data-cursor-sculpture>
  <Image src={sculpture} alt="" widths={widths[variant]} sizes="100%" loading="eager" />
</div>

<style lang="scss">
  @use 'tokens' as *;

  .sculpture {
    will-change: transform;

    :global(img) {
      width: 100%;
      height: auto;
      // Recoloreo provisorio del asset heredado a obsidiana: se desatura y
      // se oscurece conservando los brillos especulares, y el filo violeta
      // se simula con una sombra que sigue el alfa de la silueta.
      filter: grayscale(1) brightness(0.32) contrast(1.55)
        drop-shadow(0 0 7px rgba(123, 97, 255, 0.55)) drop-shadow(0 0 22px rgba(123, 97, 255, 0.22))
        drop-shadow(0 22px 44px rgba(13, 11, 10, 0.6));
    }
  }

  .sculpture--about :global(img) {
    filter: grayscale(1) brightness(0.34) contrast(1.5)
      drop-shadow(0 0 6px rgba(123, 97, 255, 0.5)) drop-shadow(0 0 20px rgba(123, 97, 255, 0.14))
      drop-shadow(0 40px 80px rgba(13, 11, 10, 0.65));
  }

  // En el 404 la pieza se lee vencida: el mismo objeto, sin tensión.
  .sculpture--lost :global(img) {
    transform: rotate(-90deg) scaleY(1.15);
    filter: grayscale(1) brightness(0.28) contrast(1.4) saturate(0.9)
      drop-shadow(0 0 8px rgba(123, 97, 255, 0.4)) drop-shadow(0 18px 40px rgba(13, 11, 10, 0.6));
  }
</style>
