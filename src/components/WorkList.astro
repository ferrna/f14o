---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { path, type Lang } from '../i18n/config';
import { useCopy } from '../i18n/ui';
import { getWork, slugOf, type Work } from '../i18n/work';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useCopy(lang);
const projects = await getWork(lang);

/** URLs ya optimizadas: el pool de nodos se arma en JS al primer hover. */
async function trailSrcs(project: Work): Promise<string[]> {
  const unique = [project.data.cover, ...project.data.gallery.map((item) => item.src)].filter(
    (src, i, all) => all.findIndex((other) => other.src === src.src) === i,
  );

  const images = await Promise.all(
    unique.map((src: ImageMetadata) => getImage({ src, width: 800, format: 'webp' })),
  );

  return images.map((img) => img.src);
}

const trails = await Promise.all(projects.map((project) => trailSrcs(project)));
---

<section class="work" id="work" data-work-gate>
  <div class="work__in" data-work-gate-panel>
  <header class="work__head">
    <p class="work__kicker">
      <span class="work__dot" aria-hidden="true"></span>02 / {c.work.kicker}
    </p>
    <p class="work__count">{String(projects.length).padStart(2, '0')} {c.work.count}</p>
  </header>

  <ul class="work__list" data-work-list>
    {
      projects.map((project, i) => (
        <li class="work__row" data-work-row>
          <a class="work__link" href={path(lang, `/work/${slugOf(project)}`)} data-cursor-project>
            <span class="work__lead">
              <span class="work__index">{String(project.data.order).padStart(2, '0')}</span>
              <span class="work__slash" aria-hidden="true">/</span>
              <span class="work__title" style={`view-transition-name: title-${slugOf(project)}`}>
                {project.data.title}
              </span>
            </span>
            <span class="work__rule" data-work-rule aria-hidden="true"></span>
            <span class="work__meta">
              <span class="work__category">{project.data.category}</span>
              <span class="work__year">{project.data.year}</span>
            </span>
          </a>
          <div
            class="work__trail"
            data-work-trail
            data-srcs={trails[i]?.join('|') ?? ''}
            aria-hidden="true"
          ></div>
        </li>
      ))
    }
  </ul>

  <p class="work__hint">{c.work.hint}</p>
  </div>
</section>

<style lang="scss">
  @use 'tokens' as *;

  .work {
    position: relative;
    z-index: $z-content;
    padding: $space-section $space-page;
  }

  .work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 6vh, 5rem);
  }

  .work__kicker {
    @include mono(0.68rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: $c-muted;
  }

  .work__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: $c-violet;
  }

  .work__count {
    @include mono(0.68rem);
    color: $c-subtle;
  }

  .work__row {
    position: relative;
  }

  .work__link {
    display: flex;
    align-items: baseline;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding: clamp(1.1rem, 2.6vh, 2rem) 0;
  }

  .work__lead {
    display: flex;
    flex-shrink: 0;
    align-items: baseline;
    gap: 0.65rem;
  }

  .work__index,
  .work__slash {
    @include display(clamp(1.9rem, 5.4vw, 4rem));
    color: $c-cream;
  }

  .work__title {
    @include display(clamp(1.9rem, 5.4vw, 4rem));
    color: $c-cream;
    text-transform: uppercase;
    transition:
      color $dur-short $ease-out-soft,
      transform $dur-short $ease-out-soft;
    transform-origin: left center;
  }

  .work__meta {
    display: none;
    align-items: baseline;
    gap: clamp(0.75rem, 2vw, 2rem);
  }

  @media (min-width: 1100px) {
    .work__meta {
      display: flex;
      flex-shrink: 0;
      opacity: 0.45;
    }
  }

  .work__category,
  .work__year {
    @include mono(0.58rem);
    color: $c-subtle;
    transition: color $dur-micro $ease-micro;
  }

  .work__rule {
    display: block;
    flex: 1;
    min-width: 2rem;
    height: 1px;
    align-self: center;
    background-color: $c-cream;
    opacity: 0.45;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .work__trail :global(.work__shot) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    width: clamp(240px, 24vw, 380px);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    border: 1px solid rgba(237, 227, 212, 0.55);
    border-radius: 2px;
    background-color: $c-obsidian;
    box-shadow: 0 24px 60px rgba(13, 11, 10, 0.65);
  }

  .work__trail :global(.work__shot-bg),
  .work__trail :global(.work__shot-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  // Misma foto, agrandada y desenfocada: rellena el 16:9 detrás del recorte nítido.
  .work__trail :global(.work__shot-bg) {
    object-fit: cover;
    filter: blur(26px) saturate(1.35) brightness(0.85);
    transform: scale(1.35);
  }

  .work__trail :global(.work__shot-img) {
    top: 50%;
    left: 50%;
    z-index: 1;
    width: auto;
    max-width: calc(100% - 24px);
    height: calc(100% - 40px);
    object-fit: contain;
    transform: translate(-50%, -50%);
  }

  // Cuando una fila se activa, las demás bajan de contraste: la atención
  // se dirige apagando el resto, no encendiendo la elegida.
  .work__list[data-hovering='true'] .work__row:not([data-active]) .work__title,
  .work__list[data-hovering='true'] .work__row:not([data-active]) .work__index,
  .work__list[data-hovering='true'] .work__row:not([data-active]) .work__slash {
    color: rgba(168, 156, 140, 0.35);
  }

  .work__row[data-active] {
    .work__index,
    .work__slash {
      color: $c-violet;
    }

    .work__title {
      color: $c-cream-bright;
      transform: translateX(clamp(8px, 1vw, 18px));
    }

    .work__category,
    .work__year {
      color: $c-muted;
    }
  }

  .work__hint {
    @include mono(0.62rem);
    margin-top: clamp(2rem, 5vh, 4rem);
    color: $c-subtle;
    opacity: 0.72;
  }

  @media (max-width: 760px) {
    .work__link {
      flex-wrap: wrap;
    }

    .work__meta {
      width: 100%;
      order: 3;
    }

    .work__rule {
      order: 2;
    }

    .work__trail {
      display: none;
    }
  }
</style>
