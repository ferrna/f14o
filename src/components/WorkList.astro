---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { path, type Lang } from '../i18n/config';
import { useCopy } from '../i18n/ui';
import { getWork, slugOf, type Work } from '../i18n/work';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useCopy(lang);
const projects = await getWork(lang);

/** Ocho capturas por fila: se reciclan mientras el rastro corre. */
const POOL = 8;

function trailOf(project: Work): ImageMetadata[] {
  const unique = [project.data.cover, ...project.data.gallery.map((item) => item.src)].filter(
    (src, i, all) => all.findIndex((other) => other.src === src.src) === i,
  );

  return Array.from({ length: POOL }, (_, i) => unique[i % unique.length]);
}
---

<section class="work" id="work" data-work-gate>
  <div class="work__in" data-work-gate-panel>
  <header class="work__head">
    <p class="work__kicker">
      <span class="work__dot" aria-hidden="true"></span>02 / {c.work.kicker}
    </p>
    <p class="work__count">{String(projects.length).padStart(2, '0')} {c.work.count}</p>
  </header>

  <ul class="work__list" data-work-list>
    {
      projects.map((project) => (
        <li class="work__row" data-work-row>
          <a class="work__link" href={path(lang, `/work/${slugOf(project)}`)} data-cursor-project>
            <span class="work__index">{String(project.data.order).padStart(3, '0')}</span>
            <span class="work__title" style={`view-transition-name: title-${slugOf(project)}`}>
              {project.data.title}
            </span>
            <span class="work__meta">
              <span class="work__category">{project.data.category}</span>
              <span class="work__year">{project.data.year}</span>
            </span>
          </a>
          <span class="work__rule" data-rule aria-hidden="true" />
          <div class="work__trail" data-work-trail aria-hidden="true">
            {
              trailOf(project).map((src) => (
                <div class="work__shot" data-work-shot>
                  <Image src={src} alt="" widths={[420]} sizes="240px" loading="lazy" />
                </div>
              ))
            }
          </div>
        </li>
      ))
    }
  </ul>

  <p class="work__hint">{c.work.hint}</p>
  </div>
</section>

<style lang="scss">
  @use 'tokens' as *;

  .work {
    position: relative;
    z-index: $z-content;
    padding: $space-section $space-page;
  }

  .work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 6vh, 5rem);
  }

  .work__kicker {
    @include mono(0.68rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: $c-muted;
  }

  .work__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: $c-violet;
  }

  .work__count {
    @include mono(0.68rem);
    color: $c-subtle;
  }

  .work__row {
    position: relative;
  }

  .work__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: clamp(1rem, 4vw, 3rem);
    padding: clamp(1.1rem, 2.6vh, 2rem) 0;
  }

  .work__index {
    @include mono(0.7rem);
    color: $c-subtle;
    transition: color $dur-micro $ease-micro;
  }

  .work__title {
    @include display(clamp(1.9rem, 5.4vw, 4rem));
    color: $c-muted;
    transition:
      color $dur-short $ease-out-soft,
      transform $dur-short $ease-out-soft;
    transform-origin: left center;
  }

  .work__meta {
    display: flex;
    align-items: baseline;
    gap: clamp(0.75rem, 2vw, 2rem);
  }

  .work__category,
  .work__year {
    @include mono(0.68rem);
    color: $c-subtle;
    transition: color $dur-micro $ease-micro;
  }

  .work__rule {
    display: block;
    height: 1px;
    background-color: $c-hairline;
    transform-origin: left center;
  }

  .work__shot {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    width: 240px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
    border: 1px solid rgba(237, 227, 212, 0.55);
    border-radius: 2px;
    box-shadow: 0 24px 60px rgba(13, 11, 10, 0.65);

    :global(img) {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  // Cuando una fila se activa, las demás bajan de contraste: la atención
  // se dirige apagando el resto, no encendiendo la elegida.
  .work__list[data-hovering='true'] .work__row:not([data-active]) .work__title {
    color: rgba(168, 156, 140, 0.35);
  }

  .work__row[data-active] {
    .work__index {
      color: $c-violet;
    }

    .work__title {
      color: $c-cream-bright;
      transform: translateX(clamp(8px, 1vw, 18px));
    }

    .work__category,
    .work__year {
      color: $c-muted;
    }
  }

  .work__hint {
    @include mono(0.62rem);
    margin-top: clamp(2rem, 5vh, 4rem);
    color: $c-subtle;
    opacity: 0.72;
  }

  @media (max-width: 760px) {
    .work__link {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .work__meta {
      order: -1;
    }

    .work__shot {
      display: none;
    }
  }
</style>
