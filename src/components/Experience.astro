---
import { stackSegments, useSite } from '../data/site';
import type { Lang } from '../i18n/config';
import { useCopy } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useCopy(lang);
const { experience } = useSite(lang);
---

<section class="xp" id="experience" data-experience>
  <p class="xp__kicker">
    <span class="xp__dot" aria-hidden="true"></span>04 / {c.experience.kicker}
  </p>

  <ol class="xp__list">
    {
      experience.map((item) => (
        <li class="xp__item" data-xp-item data-current={item.current ? 'true' : undefined}>
          <p class="xp__when">
            {item.current && <span class="xp__dot" aria-hidden="true" />}
            {item.when}
          </p>

          <div class="xp__copy">
            <p class="xp__body">
              {stackSegments(item.body).map((segment) =>
                segment.tool ? (
                  <b class="xp__firm">
                    <span class="xp__firm-text" data-xp-firm>
                      {segment.text}
                    </span>
                    <span class="xp__firm-rule" data-xp-rule aria-hidden="true" />
                  </b>
                ) : (
                  segment.text
                ),
              )}
            </p>
            <p class="xp__meta">
              {item.role}
              <span class="xp__sep" aria-hidden="true">
                ·
              </span>
              {item.place}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style lang="scss">
  @use 'tokens' as *;

  .xp {
    position: relative;
    z-index: $z-content;
    padding: clamp(5rem, 12vh, 9rem) $space-page;
  }

  .xp__kicker {
    @include mono(0.68rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
    color: $c-muted;
  }

  .xp__dot {
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: $c-violet;
  }

  .xp__item {
    display: grid;
    grid-template-columns: minmax(7rem, 14rem) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }

  .xp__item + .xp__item {
    margin-top: clamp(2.25rem, 5vh, 3.5rem);
  }

  .xp__when {
    @include mono(0.64rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-top: 0.45em;
    color: $c-subtle;
  }

  .xp__body {
    @include display(clamp(1.05rem, 2.1vw, 1.6rem));
    max-width: 36ch;
    color: $c-subtle;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.015em;
  }

  .xp__firm {
    position: relative;
    font-weight: 500;
    color: $c-cream;
  }

  .xp__firm-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.08em;
    height: 1px;
    background-color: $c-violet;
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  .xp__meta {
    @include mono(0.62rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.85rem;
    color: $c-subtle;
  }

  .xp__sep {
    color: rgba(119, 108, 96, 0.7);
  }

  .xp__item[data-current] {
    .xp__when {
      color: $c-muted;
    }

    .xp__body {
      color: $c-cream;
    }

    .xp__meta {
      color: $c-muted;
    }
  }

  .xp__item:not([data-current]) {
    .xp__firm {
      color: $c-muted;
    }
  }

  @media (max-width: 900px) {
    .xp__item {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    .xp__when {
      padding-top: 0;
    }

    .xp__body {
      max-width: none;
    }
  }
</style>
