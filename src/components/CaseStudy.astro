---
import { render } from 'astro:content';
import CaseDeck from './CaseDeck.astro';
import { path, type Lang } from '../i18n/config';
import { useCopy } from '../i18n/ui';
import { slugOf, type Work } from '../i18n/work';

interface Props {
  lang: Lang;
  project: Work;
  next: Work;
}

const { lang, project, next } = Astro.props;
const c = useCopy(lang);
const { Content } = await render(project);
const slug = slugOf(project);

const meta = [
  { label: c.case.role, value: project.data.role },
  { label: c.case.duration, value: project.data.duration ?? '—' },
  { label: c.case.stack, value: project.data.stack.join(', ') },
  { label: c.case.year, value: String(project.data.year) },
];

/** Cover + galería, sin repetir la misma foto. */
const frames: Array<{ src: (typeof project.data.cover); caption: string }> = [];
const seen = new Set<string>();
const push = (src: typeof project.data.cover, caption: string) => {
  if (seen.has(src.src)) return;
  seen.add(src.src);
  frames.push({ src, caption });
};
push(project.data.cover, project.data.gallery[0]?.caption ?? project.data.title);
for (const item of project.data.gallery) {
  push(item.src, item.caption);
}
---

<article class="case" data-case>
  <header class="case__head">
    <a class="case__back" href={path(lang, '/#work')} data-cursor-hover data-case-late>{c.case.back}</a>
    <h1 class="case__title" style={`view-transition-name: title-${slug}`}>{project.data.title}</h1>
    <p class="case__kicker">{project.data.year} — {project.data.category}</p>
  </header>

  <div data-case-late>
  <CaseDeck frames={frames} />

  <div class="case__body">
    <div class="case__prose" data-reveal>
      <Content />
    </div>

    <aside class="case__aside" data-reveal-group="blocks">
      <dl class="case__meta" data-reveal-item>
        {
          meta.map((item) => (
            <div class="case__meta-item">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        project.data.liveUrl && (
          <a
            class="case__live"
            href={project.data.liveUrl}
            rel="noopener noreferrer"
            target="_blank"
            data-cursor-hover
            data-reveal-item
          >
            <span class="case__dot" aria-hidden="true" />
            {c.case.live}
          </a>
        )
      }
    </aside>
  </div>

  <a class="case__next" href={path(lang, `/work/${slugOf(next)}`)} data-cursor-project>
    {c.case.next} — {next.data.title} →
  </a>

  <p class="case__status">
    {[...c.hero.telemetry, c.hero.build].join(' · ')}
  </p>
  </div>
</article>

<style lang="scss">
  @use 'tokens' as *;

  .case {
    position: relative;
    z-index: $z-content;
    padding: clamp(6.5rem, 14vh, 9rem) $space-page clamp(2.5rem, 6vh, 4rem);
  }

  .case__head {
    max-width: 52rem;
  }

  .case__back {
    @include mono(0.68rem);
    color: $c-muted;
    transition: color $dur-micro $ease-micro;

    &:hover {
      color: $c-cream;
    }
  }

  .case__title {
    @include display(clamp(2rem, 4.5vw, 3.4rem));
    margin-top: 1.15rem;
    color: $c-cream;
    text-transform: uppercase;
  }

  .case__kicker {
    @include mono(0.62rem);
    margin-top: 0.7rem;
    color: $c-muted;
  }

  /* El hold se pinta en before-swap para que el resto no parpadee durante el morph. */
  .case[data-case-hold] [data-case-late] {
    opacity: 0;
    pointer-events: none;
    view-transition-name: none;
  }

  .case__body {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(14rem, 0.55fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(2.5rem, 6vh, 4rem);
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .case__next {
    @include display(clamp(1.4rem, 3vw, 2.4rem));
    display: inline-block;
    color: $c-cream;
    text-transform: uppercase;
    transition: color $dur-short $ease-out-soft;

    &:hover {
      color: $c-cream-bright;
    }
  }

  .case__aside {
    padding-top: 0.15rem;
  }

  .case__meta {
    margin: 0;
  }

  .case__meta-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    @include hairline(bottom);

    dt {
      @include mono(0.6rem);
      color: $c-subtle;
    }

    dd {
      @include mono(0.68rem);
      margin: 0;
      color: $c-cream;
      text-align: right;
      text-transform: none;
    }
  }

  .case__prose {
    color: $c-muted;
    font-size: 0.95rem;
    line-height: 1.75;

    :global(h2) {
      @include mono(0.62rem);
      margin: 2rem 0 0.6rem;
      color: $c-subtle;
    }

    :global(h2:first-child) {
      margin-top: 0;
    }

    :global(p) {
      margin-bottom: 1rem;
    }
  }

  .case__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: $c-violet;
  }

  .case__live {
    @include mono(0.66rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.7rem 1.3rem;
    border: 1px solid $c-hairline-strong;
    border-radius: 999px;
    color: $c-cream;
    transition: border-color $dur-micro $ease-micro;

    &:hover {
      border-color: $c-violet;
    }
  }

  .case__status {
    @include mono(0.58rem);
    margin-top: clamp(2.5rem, 6vh, 4rem);
    padding-top: 1.5rem;
    color: $c-subtle;
    text-align: center;
    opacity: 0.72;
    @include hairline(top);
  }

  @media (max-width: 760px) {
    .case__body {
      grid-template-columns: 1fr;
    }
  }
</style>
