---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Gallery from './Gallery.astro';
import { path, type Lang } from '../i18n/config';
import { useCopy } from '../i18n/ui';
import { slugOf, type Work } from '../i18n/work';

interface Props {
  lang: Lang;
  project: Work;
  next: Work;
}

const { lang, project, next } = Astro.props;
const c = useCopy(lang);
const { Content } = await render(project);
const slug = slugOf(project);

const meta = [
  { label: c.case.role, value: project.data.role },
  { label: c.case.duration, value: project.data.duration ?? '—' },
  { label: c.case.stack, value: project.data.stack.join(', ') },
  { label: c.case.year, value: String(project.data.year) },
];
---

<article class="case">
  <div class="case__layout">
    <div class="case__main">
      <a class="case__back" href={path(lang, '/#work')} data-cursor-hover>{c.case.back}</a>

      <h1 class="case__title" style={`view-transition-name: title-${slug}`}>{project.data.title}</h1>
      <p class="case__sub">
        {project.data.year} — {project.data.category}
        {project.data.summary ? ` · ${project.data.summary}` : ''}
      </p>

      <figure class="case__cover" data-reveal>
        <Image
          src={project.data.cover}
          alt={project.data.title}
          widths={[720, 1200, 1600]}
          sizes="(max-width: 900px) 92vw, 62vw"
          loading="eager"
          style={`view-transition-name: cover-${slug}`}
        />
      </figure>

      <Gallery items={project.data.gallery} />

      <a class="case__next" href={path(lang, `/work/${slugOf(next)}`)} data-cursor-project>
        {c.case.next} — {next.data.title} →
      </a>
    </div>

    <aside class="case__aside" data-reveal-group="blocks">
      <dl class="case__meta" data-reveal-item>
        {
          meta.map((item) => (
            <div class="case__meta-item">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="case__prose" data-reveal-item>
        <Content />
      </div>

      {
        project.data.liveUrl && (
          <a
            class="case__live"
            href={project.data.liveUrl}
            rel="noopener noreferrer"
            target="_blank"
            data-cursor-hover
          >
            <span class="case__dot" aria-hidden="true" />
            {c.case.live}
          </a>
        )
      }
    </aside>
  </div>

  <p class="case__status">
    {[...c.hero.telemetry, c.hero.build].join(' · ')}
  </p>
</article>

<style lang="scss">
  @use 'tokens' as *;

  .case {
    position: relative;
    z-index: $z-content;
    padding: clamp(6.5rem, 14vh, 9rem) $space-page clamp(2.5rem, 6vh, 4rem);
  }

  .case__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(15rem, 0.7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 8vh, 5rem);
  }

  .case__back {
    @include mono(0.68rem);
    color: $c-muted;
    transition: color $dur-micro $ease-micro;

    &:hover {
      color: $c-cream;
    }
  }

  .case__title {
    @include display(clamp(3rem, 8vw, 6.5rem));
    margin-top: 1.5rem;
    color: $c-cream;
    text-transform: uppercase;
  }

  .case__sub {
    @include mono(0.62rem);
    margin-top: 0.85rem;
    color: $c-muted;
  }

  .case__cover {
    margin: clamp(2rem, 5vh, 3.5rem) 0 0;

    :global(img) {
      width: 100%;
      height: auto;
      border: 1px solid rgba(237, 227, 212, 0.45);
      border-radius: 4px;
      box-shadow: 0 30px 70px rgba(13, 11, 10, 0.6);
    }
  }

  .case__next {
    @include display(clamp(1.6rem, 3.6vw, 2.8rem));
    display: inline-block;
    margin-top: clamp(2.5rem, 6vh, 4rem);
    color: $c-cream;
    text-transform: uppercase;
    transition: color $dur-short $ease-out-soft;

    &:hover {
      color: $c-cream-bright;
    }
  }

  .case__aside {
    padding-top: 0.2rem;
  }

  .case__meta {
    margin: 0;
  }

  .case__meta-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    @include hairline(bottom);

    dt {
      @include mono(0.6rem);
      color: $c-subtle;
    }

    dd {
      @include mono(0.68rem);
      margin: 0;
      color: $c-cream;
      text-align: right;
      text-transform: none;
    }
  }

  .case__prose {
    margin-top: 2rem;
    color: $c-muted;
    font-size: 0.95rem;
    line-height: 1.75;

    :global(h2) {
      @include mono(0.62rem);
      margin: 2rem 0 0.6rem;
      color: $c-subtle;
    }

    :global(h2:first-child) {
      margin-top: 0;
    }

    :global(p) {
      margin-bottom: 1rem;
    }
  }

  .case__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: $c-violet;
  }

  .case__live {
    @include mono(0.66rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    padding: 0.7rem 1.3rem;
    border: 1px solid $c-hairline-strong;
    border-radius: 999px;
    color: $c-cream;
    transition: border-color $dur-micro $ease-micro;

    &:hover {
      border-color: $c-violet;
    }
  }

  .case__status {
    @include mono(0.58rem);
    padding-top: 1.5rem;
    color: $c-subtle;
    text-align: center;
    opacity: 0.72;
    @include hairline(top);
  }

  @media (max-width: 900px) {
    .case__layout {
      grid-template-columns: 1fr;
    }

    .case__title {
      @include display(clamp(2.4rem, 12vw, 4rem));
    }
  }
</style>
