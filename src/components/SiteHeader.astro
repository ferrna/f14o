---
import { altPath, LANG_LABEL, otherLang, path, type Lang } from '../i18n/config';
import { useCopy } from '../i18n/ui';
import Swap from './Swap.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useCopy(lang);

const nav = [
  { href: path(lang, '/#work'), label: c.nav.work, id: 'work' },
  { href: path(lang, '/about'), label: c.nav.about, id: 'about' },
  { href: path(lang, '/#contact'), label: c.nav.contact, id: 'contact' },
];

const alt = otherLang(lang);
const altHref = altPath(lang, Astro.url.pathname);
---

<header class="header" data-intro-fade>
  <a class="header__mark" href={path(lang)} aria-label={c.nav.home}>FA</a>

  <nav class="header__nav" aria-label="Main">
    {
      nav.map((item, i) => (
        <>
          {i > 0 && <span class="header__sep" aria-hidden="true">/</span>}
          <a class="header__link" href={item.href} data-nav={item.id} data-cursor-hover>
            <span class="header__dot" aria-hidden="true"></span>
            <Swap text={item.label} />
            <span class="sr-only">{item.label}</span>
          </a>
        </>
      ))
    }
  </nav>

  <div class="header__meta">
    <div class="header__lang">
      <span class="header__lang-current" aria-current="true">{LANG_LABEL[lang]}</span>
      <a class="header__lang-alt" href={altHref} hreflang={alt} data-cursor-hover>
        <Swap text={LANG_LABEL[alt]} />
        <span class="sr-only">{LANG_LABEL[alt]}</span>
      </a>
    </div>
    <time class="header__clock" data-clock datetime="">--:--</time>
  </div>

  <button
    class="header__toggle"
    type="button"
    data-menu-toggle
    aria-label={c.nav.menu}
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span class="header__toggle-line" aria-hidden="true"></span>
    <span class="header__toggle-line" aria-hidden="true"></span>
  </button>
</header>

<style lang="scss">
  @use 'tokens' as *;

  .header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: $z-header;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: clamp(1rem, 2.5vw, 1.75rem) $space-page;
    mix-blend-mode: normal;
  }

  .header__mark {
    @include display(1.35rem);
    font-stretch: $width-normal;
    color: $c-cream;
    letter-spacing: 0.02em;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-left: auto;
  }

  .header__link {
    @include mono(0.72rem);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: $c-muted;
    transition: color $dur-micro $ease-micro;

    &:hover {
      color: $c-cream;
    }
  }

  .header__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: $c-violet;
    opacity: 0;
  }

  .header__link[data-current] {
    color: $c-cream;

    .header__dot {
      opacity: 1;
    }
  }

  .header__sep {
    @include mono(0.72rem);
    color: $c-subtle;
  }

  .header__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.28rem;
    margin-left: 1.5rem;
  }

  .header__lang {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header__clock {
    @include mono(0.62rem);
    color: $c-subtle;
    opacity: 0.72;
  }

  .header__lang-current {
    @include mono(0.72rem);
    color: $c-cream;
  }

  .header__lang-alt {
    @include mono(0.72rem);
    color: $c-subtle;
    transition: color $dur-micro $ease-micro;

    &:hover {
      color: $c-cream;
    }
  }

  // El disparador del menú sólo existe en mobile; en desktop la nav es visible.
  .header__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem 0;
  }

  .header__toggle-line {
    display: block;
    width: 22px;
    height: 1px;
    background-color: $c-cream;
    transition: transform $dur-short $ease-out-soft;
  }

  // La X es una rotación real de las dos líneas, no un cambio de ícono.
  .header__toggle[aria-expanded='true'] {
    .header__toggle-line:first-child {
      transform: translateY(3px) rotate(45deg);
    }

    .header__toggle-line:last-child {
      transform: translateY(-3px) rotate(-45deg);
    }
  }

  @media (max-width: 760px) {
    .header__nav,
    .header__lang {
      display: none;
    }

    .header__meta {
      margin-left: auto;
    }

    .header__toggle {
      display: flex;
    }
  }
</style>
