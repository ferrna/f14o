---
import Base from '../../../layouts/Base.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { getWork, slugOf } from '../../../i18n/work';

const lang = 'es';

export async function getStaticPaths() {
  const projects = await getWork('es');

  return projects.map((project, i) => ({
    params: { slug: slugOf(project) },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
---

<Base
  title={`${project.data.title} — Fernando Arriondo`}
  description={project.data.summary}
  lang={lang}
  routeLabel={project.data.title}
>
  <CaseStudy lang={lang} project={project} next={next} />
</Base>
