---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.scss';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Cursor from '../components/Cursor.astro';
import Curtain from '../components/Curtain.astro';
import { LANGS, path, routeWithoutLocale, type Lang } from '../i18n/config';
import { useCopy } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Etiqueta que muestra la cortina al navegar hacia esta página. */
  routeLabel?: string;
}

const { title, description, lang = 'en', routeLabel = '' } = Astro.props;
const c = useCopy(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Las alternativas se calculan sobre la ruta sin idioma, así cada página
// declara su propio par en vez de apuntar todas a la home.
const route = routeWithoutLocale(Astro.url.pathname);
const alternates = LANGS.map((code) => ({
  code,
  href: new URL(path(code, route), Astro.site ?? Astro.url).href,
}));
---

<!doctype html>
<html lang={lang} data-route-label={routeLabel} style={`--noise-url: url('${base}/media/noise.png')`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2e2a26" />

    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}/favicon_io/apple-touch-icon.png`} />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />

    <ClientRouter />
  </head>

  <body>
    <a class="sr-only" href="#main">{c.nav.skip}</a>

    <Cursor lang={lang} />
    <Curtain />

    <SiteHeader lang={lang} />
    <MobileMenu lang={lang} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter lang={lang} />

    <script>
      import { initMotion } from '../scripts/motion';

      // Con ClientRouter, astro:page-load cubre tanto la carga inicial como
      // cada navegación posterior.
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
