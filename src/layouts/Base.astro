---
import '../styles/global.scss';
import SiteHeader from '../components/SiteHeader.astro';
import Cursor from '../components/Cursor.astro';
import Curtain from '../components/Curtain.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'es';
  /** Etiqueta que muestra la cortina al navegar hacia esta página. */
  routeLabel?: string;
}

const { title, description, lang = 'en', routeLabel = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang} data-route-label={routeLabel}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2e2a26" />

    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}/favicon_io/apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>

  <body>
    <a class="sr-only" href="#main">Skip to content</a>

    <Cursor />
    <Curtain />

    <SiteHeader lang={lang} />

    <main id="main">
      <slot />
    </main>

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
